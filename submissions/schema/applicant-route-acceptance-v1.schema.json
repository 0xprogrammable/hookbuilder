                "stateMutability": { "enum": ["nonpayable", "payable"] },
                "returns": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["index", "kind", "solidityType"],
