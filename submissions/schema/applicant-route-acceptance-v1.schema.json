        "launchCalldataHash": { "$ref": "#/$defs/bytes32" },
        "transactionCount": { "const": 1 },
        "transactionSender": { "$ref": "#/$defs/nonzeroEthereumAddress" },
        "executionEntry": { "const": "acceptance-bound-router" },
