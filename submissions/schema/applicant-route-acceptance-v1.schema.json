                      "kind": { "$ref": "#/$defs/id" },
                      "solidityType": { "type": "string", "minLength": 1, "maxLength": 100 }
                    }
                  }
                }
              }
            },
            "configurationRead": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signature", "selector", "stateMutability", "returns"],
              "properties": {
                "signature": { "type": "string", "minLength": 1, "maxLength": 200 },
                "selector": { "$ref": "#/$defs/bytes4" },
                "stateMutability": { "const": "view" },
                "returns": { "const": "bytes32" }
              }
            }
          }
        }
      }
    },
