        "feeBasisHash": { "$ref": "#/$defs/bytes32" },
        "totalFeeBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "legOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "legs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleLabel",
              "roleHash",
              "feeBps",
              "recipient",
              "recipientModeLabel",
              "recipientModeHash",
              "abiPreimage",
              "legHash"
            ],
            "properties": {
              "roleLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
              "roleHash": { "$ref": "#/$defs/bytes32" },
              "feeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "recipient": { "$ref": "#/$defs/nonzeroEthereumAddress" },
              "recipientModeLabel": { "type": "string", "minLength": 1, "maxLength": 240 },
              "recipientModeHash": { "$ref": "#/$defs/bytes32" },
              "abiPreimage": { "type": "string", "pattern": "^0x(?:[0-9a-f]{2})+$", "minLength": 322, "maxLength": 322 },
              "legHash": { "$ref": "#/$defs/bytes32" }
            }
          }
        },
        "legsHashEncoding": {
          "const": "keccak256(abi.encode(builderLegHash,programmableLegHash,holdersLegHash))"
        },
        "legsAbiPreimage": { "type": "string", "pattern": "^0x(?:[0-9a-f]{2})+$", "minLength": 66, "maxLength": 1026 },
        "legsHash": { "$ref": "#/$defs/bytes32" },
        "policyAbiPreimage": { "type": "string", "pattern": "^0x(?:[0-9a-f]{2})+$", "minLength": 386, "maxLength": 386 },
