        "tokenInitCodeHash": { "$ref": "#/$defs/bytes32" },
        "hookInitCodeBytes": { "type": "integer", "minimum": 1, "maximum": 49152 },
        "hookInitCodeHash": { "$ref": "#/$defs/bytes32" },
        "nftInitCodeBytes": { "type": "integer", "minimum": 1, "maximum": 49152 },
