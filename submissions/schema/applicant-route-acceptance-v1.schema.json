        "profileKey",
        "feeAsset",
        "feeBasisLabel",
        "feeBasisHash",
        "totalFeeBps",
        "legOrder",
        "legs",
        "legsHashEncoding",
        "legsAbiPreimage",
        "legsHash",
        "policyAbiPreimage",
        "revenuePolicyHash"
      ],
      "properties": {
        "legType": {
          "const": "ProgrammableRevenueLegV1(bytes32 roleHash,uint16 feeBps,address recipient,bytes32 recipientModeHash)"
        },
        "legTypeHash": { "$ref": "#/$defs/bytes32" },
        "policyType": {
          "const": "ProgrammableRevenuePolicyV1(bytes32 profileKey,address feeAsset,bytes32 feeBasisHash,uint16 totalFeeBps,bytes32 legsHash)"
        },
