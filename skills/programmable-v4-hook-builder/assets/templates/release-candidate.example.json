  "changes": [
    {
      "id": "complete-project-continuation",
      "kind": "feature",
      "summary": "Continue an accepted Programmable or Uniswap v4 design into complete implementation work instead of treating a missing bundled profile as a refusal condition."
    },
    {
      "id": "multi-surface-materialization",
      "kind": "feature",
      "summary": "Preserve bounded caller-supplied contract, web, service, or game source trees as inert, byte-bound local project materialization inputs without executing candidate code."
    },
    {
      "id": "generic-application-handoff",
      "kind": "feature",
      "summary": "Produce a deterministic no-write handoff that binds the complete project, central launch-policy preimages, protected Submit base, and intended draft pull-request identity."
    },
    {
      "id": "sandbox-host-contract",
      "kind": "feature",
      "summary": "Add a deterministic external sandbox-host integration plan while keeping portable execution and completion fail-closed until independently trusted host evidence exists."
    },
    {
      "id": "journey-benchmark",
      "kind": "feature",
      "summary": "Add a versioned, anti-leakage benchmark harness for comparing Builder journeys, activation traces, repository outcomes, efficiency, effects, and independent judge results."
    },
    {
      "id": "lean-portable-package",
      "kind": "optimization",
      "summary": "Separate repository-only development tests from the portable runtime through one manifest-bound package closure and retain installed runtime smoke verification."
    }
  ],
