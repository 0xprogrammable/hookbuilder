{
  "$schema": "urn:programmable:portable-skill-package-inclusion:1.0.0",
  "schemaVersion": "1.0.0",
  "kind": "programmable-portable-skill-package-inclusion",
  "sourceRoot": "skills/programmable-v4-hook-builder",
  "includes": [
    {
      "path": "LICENSE.txt",
      "recursive": false,
      "role": "license"
    },
    {
      "path": "SKILL.md",
      "recursive": false,
      "role": "instructions"
    },
    {
      "path": "THIRD_PARTY_NOTICES.md",
      "recursive": false,
      "role": "notices"
    },
    {
      "path": "agents",
      "recursive": true,
      "role": "host-interface"
    },
    {
      "path": "assets",
      "recursive": true,
      "role": "runtime-assets-and-frozen-replay"
    },
    {
      "path": "portable-package.json",
      "recursive": false,
      "role": "package-boundary"
    },
    {
      "path": "references",
      "recursive": true,
      "role": "routed-knowledge-and-contracts"
    },
    {
      "path": "scripts",
      "recursive": true,
      "role": "runtime-and-installed-verification"
    }
  ],
  "executablePaths": [
    "scripts/builder-lifecycle.mjs",
    "scripts/project-compiler.mjs",
    "scripts/template-catalog.mjs"
  ],
  "exclusions": [
    {
      "classification": "test-only",
      "path": "scripts/test",
      "recursive": true,
      "repositoryPath": "test/portable-skill",
      "repositoryDigestAlgorithm": "sha256-path-nul-size-nul-content-nul-v1",
      "repositoryFiles": 105,
      "repositoryBytes": 3126125,
      "repositorySha256": "38f8c98dbb50b356a69046a92bb3263dd3e13bf7313dde1bf5345190d2ba8db8"
    }
  ]
}
