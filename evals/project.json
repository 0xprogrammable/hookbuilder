{
  "name": "evals",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "evals",
  "projectType": "library",
  "tags": ["type:evals"],
  "targets": {
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/evals/validate-evals.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test evals/tests/*.test.mjs"
      }
    },
    "eval": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/evals/run-model-evals.mjs --suite programmable-v4-hook-builder"
      }
    },
    "eval:release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/evals/run-model-evals.mjs --suite programmable-v4-hook-builder --require-provider"
      }
    },
    "e2e:validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/evals/run-e2e-evals.mjs --validate-only"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/evals/run-e2e-evals.mjs"
      }
    },
    "e2e:release": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/evals/run-e2e-evals.mjs --require-provider"
      }
    }
  }
}
