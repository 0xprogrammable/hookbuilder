{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:project-sandbox-trust-root:1.0.0",
  "title": "Programmable project sandbox trust root",
  "description": "A key-and-scope document for signature inspection. Supplying this document to portable tooling never establishes owner trust or completion authority; production trust roots must be pinned independently in the repository-controlled completion path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "rootId", "authorities"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "programmable-project-sandbox-trust-root" },
    "rootId": { "$ref": "#/$defs/slug" },
    "authorities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "keyId", "status", "algorithm", "publicKeySpkiBase64", "publicKeySha256", "profileSha256", "launcher", "runtime"],
        "properties": {
          "subject": { "$ref": "#/$defs/subject" },
          "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
          "status": { "enum": ["active", "revoked"] },
          "algorithm": { "const": "ed25519" },
          "publicKeySpkiBase64": { "type": "string", "minLength": 32, "maxLength": 4096, "contentEncoding": "base64" },
          "publicKeySha256": { "$ref": "#/$defs/sha256" },
          "profileSha256": { "$ref": "#/$defs/sha256" },
          "launcher": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "binarySha256"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "binarySha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "imageSha256", "isolation"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "imageSha256": { "$ref": "#/$defs/sha256" },
              "isolation": { "const": "container-separate-user" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subject": { "type": "string", "pattern": "^urn:programmable:sandbox:[a-z0-9]+(?:[.:_-][a-z0-9]+)*$", "maxLength": 240 }
  }
}
