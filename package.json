{
  "name": "@programmable/v4-builder-repository",
  "version": "0.5.1",
  "description": "Portable, evidence-first Uniswap v4 project builder for Programmable.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/verify-repository.mjs",
    "test": "node scripts/verify-repository.mjs",
    "test:evals": "node scripts/evals/validate-evals.mjs",
    "test:evals:e2e": "node --test evals/tests/e2e-corpus.test.mjs evals/tests/e2e-external-evidence.test.mjs evals/tests/e2e-run.test.mjs evals/tests/run-blind-forward-tests.test.mjs evals/tests/run-e2e-evals.test.mjs evals/tests/run-model-evals.test.mjs evals/tests/validate-evals.test.mjs evals/tests/validate-forward-tests.test.mjs",
    "evals:e2e:validate": "node scripts/evals/run-e2e-evals.mjs --validate-only",
    "test:repository": "node --test test/repository-contract.test.mjs test/release-evidence.test.mjs",
    "test:skill": "node skills/programmable-v4-hook-builder/scripts/verify-skill.mjs",
    "submission:check": "node scripts/validate-applicant-submission.mjs",
    "submission:check:all": "node scripts/validate-applicant-submission.mjs --all",
    "route:check": "node scripts/check-route-compatibility.mjs",
    "route:catalog:check": "node scripts/validate-route-capability-catalog.mjs",
    "plugin:check": "node scripts/generate-plugin-manifests.mjs --check",
    "plugin:write": "node scripts/generate-plugin-manifests.mjs --write",
    "release:candidate": "node scripts/prepare-release-candidate.mjs",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs",
    "quality:coverage": "node scripts/quality/coverage-baseline.mjs",
    "quality:mutations": "node scripts/quality/mutation-gate.mjs",
    "quality:size": "node scripts/quality/size-budget.mjs",
    "quality:advisories": "node scripts/quality/dependency-advisory.mjs",
    "quality:deprecations": "node scripts/quality/package-deprecation.mjs",
    "quality:semantic-rules": "node skills/programmable-v4-hook-builder/scripts/validate-semantic-rule-registry.mjs",
    "quality:maintainability": "npm run quality:coverage && npm run quality:mutations && npm run quality:size",
    "skill:publish-check": "gh skill publish --dry-run",
    "templates": "node skills/programmable-v4-hook-builder/scripts/cli.mjs templates list"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xprogrammable/hookbuilder.git"
  },
  "bugs": {
    "url": "https://github.com/0xprogrammable/hookbuilder/issues"
  },
  "homepage": "https://github.com/0xprogrammable/hookbuilder#readme"
}
